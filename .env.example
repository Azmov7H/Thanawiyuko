# Copy to .env.local for development. Never commit real secrets.

# MongoDB Atlas (dev cluster). Required for auth + profiles.
DATABASE_URL="mongodb://localhost:27017/thanawico"

# Auth.js session encryption (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-dev"

# Public app URL (used for SSG url() metadata, OpenRouter referer, sitemap/robots)
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- AI gateway (OpenRouter-compatible) ---
AI_GATEWAY_URL="https://openrouter.ai/api/v1"
AI_GATEWAY_KEY="sk-change-me"
AI_MODEL_TUTOR="openrouter/auto:cheap"
AI_MODEL_TUTOR_PREMIUM="openrouter/auto:balanced"
AI_MODEL_FALLBACK="openrouter/auto:cheapest"
AI_QUOTA_FREE="10"
AI_QUOTA_PLUS="100"
AI_PER_MINUTE_LIMIT="8"
AI_RESPONSE_CAP="800"
AI_EXPLANATION_CACHE_TTL="604800"
AI_BUDGET_ALERT_PCT="0.8"

# --- Paymob (subscriptions) ---
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""

# --- Ops ---
CRON_SECRET="change-me"
PRACTICE_DAILY_LIMIT="30"