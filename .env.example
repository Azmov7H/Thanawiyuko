# Copy to .env.local for development. Never commit real secrets.

# MongoDB Atlas (dev cluster). Required for auth + profiles.
DATABASE_URL="mongodb://localhost:27017/thanawico"

# Auth.js session encryption (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-dev"

# Public app URL (used for SSG url() metadata, OpenRouter referer, sitemap/robots)
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- AI gateway (OpenRouter-compatible) ---
AI_GATEWAY_URL="https://openrouter.ai/api/v1"
AI_GATEWAY_KEY="sk-change-me"
AI_MODEL_TUTOR="openrouter/auto:cheap"
AI_MODEL_TUTOR_PREMIUM="openrouter/auto:balanced"
AI_MODEL_FALLBACK="openrouter/auto:cheapest"
AI_QUOTA_FREE="10"
AI_QUOTA_PLUS="100"
AI_PER_MINUTE_LIMIT="8"
AI_RESPONSE_CAP="800"
AI_EXPLANATION_CACHE_TTL="604800"
AI_BUDGET_ALERT_PCT="0.8"

# --- Paymob (subscriptions) ---
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""

# --- Ops ---
CRON_SECRET="change-me"
FREE_PRACTICE_DAILY_LIMIT="30"
LOG_LEVEL="info"

# Account deletion grace period before final anonymization (days)
DELETION_GRACE_DAYS="30"

# PDF engine: "chromium" (self-host with a browser) or "disabled"
PDF_ENGINE="chromium"

# Notification email provider: "console" (logs only) or "resend" (T-L2)
NOTIFICATION_PROVIDER="console"
# Required when NOTIFICATION_PROVIDER="resend"
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Thanawico <no-reply@thanawico.com>"

# --- Error monitoring (Sentry) — all optional; error capture is a no-op when unset ---
# SENTRY_DSN="https://<key>@o<orgId>.ingest.sentry.io/<projectId>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<orgId>.ingest.sentry.io/<projectId>"
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# --- Distributed rate limiting (Upstash Redis) — optional; falls back to in-memory ---
# UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# Feature flags (kill switches). "true" or "1" enables the feature; set to disable.
# FEATURE_MAINTENANCE_MODE="true"
# FEATURE_AI_ENABLED="false"
# FEATURE_PAYMENTS_ENABLED="false"
# FEATURE_EXAMS_ENABLED="false"

# --- Tests ---
# Optional: DB used by `npm run test:integration` (name MUST end in `_test`).
# Defaults to mongodb://127.0.0.1:27017/thanawico_test
# MONGODB_URI_TEST="mongodb://127.0.0.1:27017/thanawico_integration_test"