# Copy to .env.local for development. Never commit real secrets.
# See README §31 for the full variable list.

# MongoDB Atlas (dev cluster). Required for auth + profiles.

# Auth.js session encryption (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-dev"

# Public app URL (dev)
NEXTAUTH_URL="http://localhost:3000"

